{% extends 'base.html.twig' %}

{% block title %}{{ 'title.sign_up'|trans }}{% endblock %}

{% block body %}
<div class="custom-card">
    <div class="card">
    <h1>{{ 'title.sign_up'|trans }}</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
    {{ form_row(registrationForm.email) }}
    {{ form_row(registrationForm.name) }}

    {{ form_row(registrationForm.password) }}

    {% if false == registrationForm.vars.valid %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'danger',
            message: 'message.form_error'|trans,
        }%}
    {% endif %}
        <div class="form-group row float-sm-right">
    <button type="submit" class="btn btn-primary">{{ 'action.sign_up'|trans }}</button>
    {{ form_end(registrationForm) }}
        </div>

    </div>
</div>

{% endblock %}
