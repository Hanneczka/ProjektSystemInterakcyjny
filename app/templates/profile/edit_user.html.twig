{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.user_edit'|trans({'%id%': app.user.id}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.user_edit'|trans({'%id%': app.user.id}) }}</h1>

    {{ form_start(form) }}

    {% if false == form.vars.valid %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'danger',
            message: 'message.form_error'|trans,
        }%}
    {% endif %}

    {{ form_widget(form) }}

    <div class="form-group row float-sm-right" style="display: inline-block;">
        <input type="submit" value="{{ 'action.edit'|trans }}" class="btn btn-primary"/>
    </div>
    <div class="form-group row float-sm-left" style="display: inline-block; margin-right: 20px;">
        <a href="{{ path('user_profile', {'id': app.user.id}) }}" class="btn btn-link">
            {{ 'action.back_to_list'|trans }}
        </a>

    </div>

    {{ form_end(form) }}
{% endblock %}
