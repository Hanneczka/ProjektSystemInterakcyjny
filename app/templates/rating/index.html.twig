{% extends 'base.html.twig'%}

{% block title %}
    {{ 'title.highest_rated'|trans }}
{% endblock %}

{% block body %}
    <div class="card my-4">
        <div class="card-header bg-dark text-white">
            <h5>{{ 'title.highest_rated'|trans }}</h5>
        </div>
        <ul class="list-group list-group-flush">
            {% for element in highest_rated %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="{{ path('element_view', {'id': element[0].id}) }}">
                        {{ element[0].title }}
                    </a>

                    <span class="badge bg-success">
            {{ (element.avg_rating ?? 0)|number_format(1) }} / 5
        </span>
                </li>
            {% else %}
                <li class="list-group-item text-muted">{{ 'message.empty_list'|trans }}</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
