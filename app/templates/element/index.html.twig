{% extends 'base.html.twig' %}

{% block body %}
    <h1>Lista Elementów</h1>
    {% if pagination is defined and pagination.items|length %}
    <div class="navigation text-center">
        {{ knp_pagination_render(pagination) }}
    </div>
    <table border="1">
        <thead>
        <tr>
            <th>{{ knp_pagination_sortable(pagination, 'Id', 'element.id') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Tytuł', 'element.title') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Autor', 'element.author') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Rok wydania', 'element.year') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Kategoria', 'element.category') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Tagi', 'element.tag') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Utworzono', 'element.createdAt') }}</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        {% for element in pagination %}
            <tr>
                <td>{{ element.id }}</td>
                <td>{{ element.title }}</td>
                <td>{{ element.author }}</td>
                <td>{{ element.year }}</td>
                <td>{{ element.category.name }}</td>
                <td>{{ element.tags|map(t => t.title)|join(', ') }}</td>
                <td>{{ element.createdAt|date('Y-m-d H:i') }}</td>
                <td><a href="{{ path('element_view', {id: element.id}) }}">
                        {{ 'element.view' }}
                    </a></td>
                <td><a href="{{ path('element_edit', {id: element.id}) }}">
                        {{ 'element.edit' }}
                    </a></td>
                <td><a href="{{ path('element_delete', {id: element.id}) }}">
                        {{ 'element.delete' }}
                    </a></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Brak elementów w bazie.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <p>Brak elementów do wyświetlenia.</p>
    {% endif %}
    <a href="{{ path('element_create') }}">Dodaj nowy element</a>

{% endblock %}
