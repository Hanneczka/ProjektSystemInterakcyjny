{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.record_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.record_list'|trans }}</h1>
    {% if pagination is defined and pagination.items|length %}
    <div class="navigation text-center">
        {{ knp_pagination_render(pagination) }}
    </div>
    <table border="1">
        <thead>
        <tr>
            <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'element.id') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.title'|trans, 'element.title') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.author'|trans, 'element.author') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.year'|trans, 'element.year') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.category'|trans, 'category.name') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.tags'|trans, 'element.tags') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'element.createdAt') }}</th>
            <th>{{ 'label.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for element in pagination %}
            <tr>
                <td>{{ element.id }}</td>
                <td>{{ element.title }}</td>
                <td>{{ element.author }}</td>
                <td>{{ element.year }}</td>
                <td>{{ element.category.name }}</td>
                <td>{{ element.tags|map(t => t.title)|join(', ') }}</td>
                <td>{{ element.createdAt|format_date('long') }}</td>
                <td><a href="{{ path('element_view', {id: element.id}) }}">
                        {{ 'action.view'|trans }}
                    </a></td>
                <td><a href="{{ path('element_edit', {id: element.id}) }}">
                        {{ 'action.edit'|trans }}
                    </a></td>
                <td><a href="{{ path('element_delete', {id: element.id}) }}">
                        {{ 'action.delete'|trans }}
                    </a></td>
            </tr>
        {% else %}
            <tr>
                <td>{{ 'message.empty_list'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <p>{{ 'message.empty_list'|trans }}</p>
    {% endif %}
    <a href="{{ path('element_create') }}">{{ 'title.element_create'|trans }}</a>

{% endblock %}
