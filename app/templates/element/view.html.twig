{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.record_view'|trans }}
{% endblock %}

{% block body %}
<div class="m-4">
<div class="row">
    <div class="col-12 col-md-8 text-right">
    {% if element is defined and element|length %}
         <h1>{{ element.title }}</h1>
        <dl class="row mt-3">
            <dt class="col-sm-3">{{ 'label.author'|trans }}</dt>
            <dd class="col-sm-9">{{ element.author }}</dd>
            <dt class="col-sm-3">{{ 'label.year'|trans }}</dt>
            <dd class="col-sm-9">{{ element.year }}</dd>
            <dt class="col-sm-3">{{ 'label.category'|trans }}</dt>
            <dd class="col-sm-9">{{ element.category.name }}</dd>
            <dt class="col-sm-3">{{ 'label.tags'|trans }}</dt>
            <dd class="col-sm-9">{{ element.tags|map(t => t.title)|join(', ') }}</dd>
            <dt class="col-sm-3">{{ 'label.created_at'|trans }}</dt>
            <dd class="col-sm-9">{{ element.createdAt|format_date('long') }}</dd>
        </dl>
    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}
    {% if app.user %}
        <a href="{{ path('element_favorite', {'id': element.id}) }}" class="btn btn-sm mb-4">
            {% if element in app.user.favorites %}
                <button class="btn btn-outline-danger"><i class="bi bi-heart-fill m-2"></i>{{ 'action.delete_from_favorites'|trans }}</button>
            {% else %}
                <button class="btn btn-danger"><i class="bi bi-heart m-2"></i>{{ 'action.add_to_favorites'|trans }}</button>
            {% endif %}
        </a>
    {% endif %}
    <div class="rating p-3 bg-light rounded mb-4">
        <h4>{{ 'label.rating'|trans }}</h4>
        <div class="average-rating mb-3">
            <dl>
            <dt>{{ 'label.avarage_rating'|trans }}</dt>
            {% if average_rating %}
                <span class="badge bg-success fs-6 mt-2">{{ average_rating|number_format(1) }} / 5</span>
            {% else %}
                <span class="text-muted">{{ 'message.no_ratings'|trans }}</span>
            {% endif %}
            </dl>
        </div>

        {% if app.user %}

            {% if user_rating %}
                <div class="alert alert-info mb-0">
                    <strong> {{ 'label.your_rating'|trans }} {{ user_rating.value }} / 5</strong>
                    <form action="{{ path('element_rate_delete', {'id': element.id}) }}" method="POST" class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            {{ 'action.delete_rating'|trans }}
                        </button>
                    </form>
                </div>
            {% else %}

                {{ form_start(form, {'action': path('element_rate', {'id': element.id})}) }}
                <div class="d-flex align-items-center gap-3 my-2">
                    {% for child in form.value %}
                        <div class="form-check form-check-inline m-0">
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </div>
                    {% endfor %}
                </div>
                <button class="btn btn-primary mt-2">{{ 'action.rate'|trans }}</button>
                {{ form_end(form) }}
            {% endif %}

        {% else %}
            <div class="alert alert-warning mb-0">
                <p class="mb-0"> {{ 'message.log_in_to_rate'|trans }}</p>
            </div>
        {% endif %}

    </div>
    </div>
    <div class="col-12 col-md-4 text-center">
        <div class="card p-3 shadow-sm">

    {% if element.cover %}
        <img src="{{ asset('uploads/covers/' ~ element.cover.fileName) }}" alt="Cover" class="img-fluid rounded mb-3">
        {% if is_granted('COVER_DELETE', element.cover) %}
            <a href="{{ path('cover_delete', {'id': element.cover.id}) }}"
               class="btn btn-danger bt-sm m-1">
                {{ 'action.delete_cover'|trans }}
            </a>
        {% endif %}
        {% if is_granted('COVER_EDIT', element.cover) %}
            <a href="{{ path('cover_edit', {'id': element.cover.id}) }}"
               class="btn btn-primary bt-sm m-1">
                {{ 'action.edit_cover'|trans }}
            </a>
        {% endif %}
    {% else %}
        <img src="{{ asset('images/no-cover.png') }}" alt="{{ 'message.no_cover'|trans }}" class="img-fluid rounded mb-3">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('cover_create', {id: element.id}) }}" class="btn btn-primary btn-sm d-block">
                {{ 'action.cover_create'|trans }}</a>
        {% endif %}
    {% endif %}
    </div>
    </div>

</div>

    <h3 class="mt-4">{{ 'title.comments'|trans }}</h3>
<div class="comments-section">
    <div class="mb-4">
    {% if app.user %}
        {{ form_start(comment_form, {'action': path('element_comment_add', {'id': element.id}), 'method': 'POST'}) }}
        {{ form_widget(comment_form) }}
        <div class="d-flex justify-content-end">
        <button class="btn btn-primary mt-2">{{ 'action.send_comment'|trans }}</button>
        </div>
        {{ form_end(comment_form) }}
    {% else %}
        <p>{{ 'message.log_in_to_comment'|trans }}</p>
    {% endif %}
    </div>

    <ul>
        {% for comment in comment_pagination %}
            <li class="card p-3 mb-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>{{ comment.author.name }}</strong>
                    <span class="text-muted small">({{ comment.createdAt|format_date('long') }})</span>
                </div>
                <p>{{ comment.content }}</p>
                {% if is_granted('COMMENT_DELETE', comment) %}
                    <td >
                        <div class="d-flex justify-content-end">
                        <a href="{{ path('comment_delete', {id: comment.id}) }}"class="btn btn-outline-danger btn-sm">
                            {{ 'action.delete'|trans }}
                        </a>
                        </div> </td>
                {% endif %}
            </li>
        {% else %}
            <li>{{ 'message.no_comments'|trans }}</li>
        {% endfor %}
    </ul>

    <div class="navigation">
        {{ knp_pagination_render(comment_pagination) }}
    </div>
</div>
</div>

{% endblock %}
