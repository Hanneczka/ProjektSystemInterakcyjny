{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.record_view'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.record_view'|trans }}</h1>


    {% if element is defined and element|length %}
         <h2>{{ element.title }}</h2>
        <dl>
            <dt>{{ 'label.author'|trans }}</dt>
            <dd>{{ element.author }}</dd>
            <dt>{{ 'label.year'|trans }}</dt>
            <dd>{{ element.year }}</dd>
            <dt>{{ 'label.category'|trans }}</dt>
            <dd>{{ element.category.name }}</dd>
            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>{{ element.tags|map(t => t.title)|join(', ') }}</dd>
            <dt>{{ 'label.created_at'|trans }}</dt>
            <dd>{{ element.createdAt|format_date('long') }}</dd>
        </dl>
    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}
    {% if app.user %}
        <a href="{{ path('element_favorite', {'id': element.id}) }}" class="btn btn-sm">
            {% if element in app.user.favorites %}
                <span class="text-danger">{{ 'action.delete_from_favorites'|trans }}</span>
            {% else %}
                <span class="text-secondary">{{ 'action.add_to_favorites'|trans }}</span>
            {% endif %}
        </a>
    {% endif %}
    <div class="rating">
        <h3>{{ 'label.rating'|trans }}</h3>
        <div class="average-rating">
            <strong>{{ 'label.avarage_rating'|trans }}</strong>
            {% if average_rating %}
                <span class="badge bg-success">{{ average_rating|number_format(1) }} / 5</span>
            {% else %}
                <span class="text-muted">{{ 'message.no_ratings'|trans }}</span>
            {% endif %}
        </div>

        {% if app.user %}

            {% if user_rating %}
                <div class="alert alert-info">
                    {{ 'label.your_rating'|trans }} <strong>{{ user_rating.value }} / 5</strong>
                </div>
            {% else %}
                {{ form_start(form, {'action': path('element_rate', {'id': element.id})}) }}
                {{ form_widget(form) }}
                <button class="btn btn-primary mt-2">{{ 'action.rate'|trans }}</button>
                {{ form_end(form) }}
            {% endif %}

        {% else %}
            <div class="alert alert-warning">
                <p> {{ 'message.log_in_to_rate'|trans }}</p>
            </div>
        {% endif %}

    </div>

    {% if element.cover %}
        <img src="{{ asset('uploads/covers/' ~ element.cover.fileName) }}" alt="Cover">
        {% if is_granted('COVER_DELETE', element.cover) %}
            <a href="{{ path('cover_delete', {'id': element.cover.id}) }}"
               class="btn btn-danger"
            >
                {{ 'action.delete_cover'|trans }}
            </a>
        {% endif %}
        {% if is_granted('COVER_EDIT', element.cover) %}
            <a href="{{ path('cover_edit', {'id': element.cover.id}) }}"
               class="btn btn-primary"
            >
                {{ 'action.edit_cover'|trans }}
            </a>
        {% endif %}
    {% else %}
        <img src="{{ asset('images/no-cover.png') }}" alt="{{ 'message.no_cover'|trans }}">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('cover_create', {id: element.id}) }}"class="btn btn-primary">

                {{ 'action.cover_create'|trans }}</a>
        {% endif %}
    {% endif %}

    {% if app.user %}
        {{ form_start(comment_form) }}
        {{ form_widget(comment_form) }}
        <button class="btn btn-primary mt-2">{{ 'action.send_comment'|trans }}</button>
        {{ form_end(comment_form) }}
    {% else %}
        <p>{{ 'message.log_in_to_comment'|trans }}</p>
    {% endif %}

    <ul>
        {% for comment in comment_pagination %}
            <li>
                <strong>{{ comment.author.name }}</strong> ({{ comment.createdAt|format_date('long') }}):
                <p>{{ comment.content }}</p>
                {% if is_granted('COMMENT_DELETE', comment) %}
                    <td><a href="{{ path('comment_delete', {id: comment.id}) }}"class="btn btn-primary">
                            {{ 'action.delete'|trans }}
                        </a></td>
                {% endif %}
            </li>
        {% else %}
            <li>{{ 'message.no_comments'|trans }}</li>
        {% endfor %}
    </ul>

    <div class="navigation">
        {{ knp_pagination_render(comment_pagination) }}
    </div>

{% endblock %}
