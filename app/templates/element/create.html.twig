{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.element_create'|trans }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
    <h1>{{ 'label.title'|trans }}</h1>
    {{ form_row(form.title) }}
    <h1>{{ 'label.category'|trans }}</h1>
    {{ form_row(form.category) }}
    <h1>{{ 'label.author'|trans }}</h1>
    {{ form_row(form.author) }}
    <h1>{{ 'label.year'|trans }}</h1>
    {{ form_row(form.year) }}
    <h1>{{ 'label.tags'|trans }}</h1>
    {{ form_row(form.tags) }}
    <div class="form-group row float-sm-right">
        <input type="submit" value="{{ 'action.save'|trans }}" class="btn btn-primary"/>
    </div>
    <div class="form-group row float-sm-left">
        <a href="{{ url('element_index') }}" class="btn btn-link">
            {{ 'action.back_to_list'|trans }}
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}

