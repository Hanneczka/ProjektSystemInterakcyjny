{% extends 'base.html.twig' %}

{% block title %}
    {{ 'name.element_edit'|default('') }}
{% endblock %}

{% block body %}
    <h1>{{ 'name.element_edit'|default('') }}</h1>
    {{ form_start(form) }}
    {{ form_start(form) }}
    <h1>{{ 'title.element_create'|trans }}</h1>
    {{ form_row(form.title) }}
    <h1>{{ 'category.element_create'|trans }}</h1>
    {{ form_row(form.category) }}
    <h1>{{ 'author.element_create'|trans }}</h1>
    {{ form_row(form.author) }}
    <h1>{{ 'year.element_create'|trans }}</h1>
    {{ form_row(form.year) }}
    <h1>{{ 'tag.element_create'|trans }}</h1>
    {{ form_row(form.tags) }}
    <div class="form-group row float-sm-right">
        <input type="submit" value="{{ 'Zapisz zmiany' }}" class="btn btn-primary"/>
    </div>
    <div class="form-group row float-sm-left">
        <a href="{{ url('element_index') }}" class="btn btn-link">
            {{ 'action.back_to_list' }}
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}
