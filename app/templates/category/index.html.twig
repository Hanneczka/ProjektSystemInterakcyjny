{% extends 'base.html.twig' %}

{% block body %}
    <h1>Lista Kategorii</h1>

    <table border="1">
        <thead>
        <tr>
            <th>ID</th>
            <th>Nazwa</th>
            <th>Data utworzenia</th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.createdAt|date('Y-m-d H:i') }}</td>
                <td><a href="{{ path('category_edit', {id: category.id}) }}">
                        {{ 'action.edit'|trans }}
                    </a></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Brak kategorii w bazie.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('category_create') }}">Dodaj nową kategorię</a>

{% endblock %}
