{% extends 'base.html.twig' %}

{% block body %}
    <h1>Lista Kategorii</h1>
    {% if pagination is defined and pagination.items|length %}
    <div class="navigation text-center">
        {{ knp_pagination_render(pagination) }}
    </div>

    <table border="1">
        <thread>
        <tr>
            <th>{{ knp_pagination_sortable(pagination, 'Id', 'category.id') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Tytuł', 'category.name') }}</th>
            <th>{{ knp_pagination_sortable(pagination, 'Utworzono', 'category.createdAt') }}</th>
            <th>Akcje</th>
        </tr>
        </thread>
        <tbody>
        {% for category in pagination %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.createdAt|date('Y-m-d H:i') }}</td>
                <td><a href="{{ path('category_view', {id: category.id}) }}">
                        {{ 'category.view' }}
                    </a></td>
                <td><a href="{{ path('category_edit', {id: category.id}) }}">
                        {{ 'action.edit' }}
                    </a></td>
                <td><a href="{{ path('category_delete', {id: category.id}) }}">
                        {{ 'action.delete' }}
                    </a></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Brak kategorii w bazie.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <p>Brak elementów do wyświetlenia.</p>
    {% endif %}
    <a href="{{ path('category_create') }}">Dodaj nową kategorię</a>

{% endblock %}
