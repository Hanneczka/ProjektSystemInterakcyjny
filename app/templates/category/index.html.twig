{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.category_list'|trans }}
{% endblock %}

{% block body %}

    <h1>{{ 'title.category_list'|trans }}</h1>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('category_create') }}" class="btn btn-primary m-3">{{ 'title.category_create'|trans }}</a>
    {% endif %}

    {% if pagination is defined and pagination.items|length %}

    <div class="navigation text-center">
        {{ knp_pagination_render(pagination) }}
    </div>

    <table class="table table-stripped" border="1">
        <thead>
        <tr>
            {% if is_granted('ROLE_ADMIN') %}
            <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'category.id') }}</th>
            {% endif %}
            <th>{{ knp_pagination_sortable(pagination, 'label.category'|trans, 'category.name') }}</th>
            {% if is_granted('ROLE_ADMIN') %}
            <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'category.createdAt') }}</th>
            <th></th>
            <th></th>
            {% endif %}
        </tr>
        </thead>
        <tbody>
        {% for category in pagination %}
            <tr>
                {% if is_granted('ROLE_ADMIN') %}
                <td>{{ category.id }}</td>
                {% endif %}
                {% if is_granted('CATEGORY_VIEW', category) %}
                <td><h5><a href="{{ path('category_view', {id: category.id}) }}" class='title'>
                            {{ category.name }}
                    </a></h5></td>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                <td>{{ category.createdAt|format_date('long') }}</td>
                {% endif %}
                {% if is_granted('CATEGORY_EDIT', category) %}
                <td><a href="{{ path('category_edit', {id: category.id}) }}" class="btn btn-primary">
                        {{ 'action.edit'|trans }}
                    </a></td>
                {% endif %}
                {% if is_granted('CATEGORY_DELETE', category) %}
                <td><a href="{{ path('category_delete', {id: category.id}) }}" class="btn btn-danger">
                        {{ 'action.delete'|trans }}
                    </a></td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                {{ 'message.empty_list'|trans }}
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'warning',
            message: 'message.empty_list'|trans} %}
    {% endif %}

{% endblock %}
