{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.password_edit'|trans({'%id%': form.vars.data.id}) }}
{% endblock %}

{% block body %}

<div class="custom-card">
    <div class="card">

    <h1>{{ 'title.password_edit'|trans({'%id%': form.vars.data.id}) }}</h1>

    {{ form_start(form) }}

    {% if false == form.vars.valid %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'danger',
            message: 'message.form_error'|trans,
        }%}
    {% endif %}



    {{ form_widget(form) }}


    <div class="form-group row float-sm-right m-1">
        <input type="submit" value="{{ 'action.edit'|trans }}" class="btn btn-primary"/>
    </div>
    <div class="form-group row float-sm-right m-1">

        <a href="{{ path('user_index') }}" class="btn btn-link">
            {{ 'action.back_to_list'|trans }}
        </a>
    </div>

    {{ form_end(form) }}
</div>
</div>
{% endblock %}
