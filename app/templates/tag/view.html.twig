{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_view'|trans }}
{% endblock %}

{% block body %}
    <h1>View record</h1>
    {% if tag is defined and tag|length %}
        <dl>
            {{ 'label.tags'|trans }}
            <dd>{{ tag.title }}</dd>
            {{ 'label.created_at'|trans }}
            <dd>{{ tag.createdAt|date('Y-m-d H:i:s') }}</dd>
        </dl>
    {% else %}
        <p>
        <p>{{ 'message.record_not_found'|trans }}</p>
        </p>
    {% endif %}


{% endblock %}
