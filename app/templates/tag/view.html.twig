{% extends 'base.html.twig' %}

{% block title %}
    View tag
{% endblock %}

{% block body %}
    <h1>View record</h1>
    {% if tag is defined and tag|length %}
        <dl>
            <dt>Title</dt>
            <dd>{{ tag.title }}</dd>
            <dt>When Added</dt>
            <dd>{{ tag.createdAt|date('Y-m-d H:i:s') }}</dd>
        </dl>
    {% else %}
        <p>
            Record not found.
        </p>
    {% endif %}


{% endblock %}
