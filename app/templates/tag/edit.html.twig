{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_edit'|default('') }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.tag_edit'|default('') }}</h1>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <div class="form-group row float-sm-right">
        <input type="submit" value="{{ 'Zapisz zmiany' }}" class="btn btn-primary"/>
    </div>
    <div class="form-group row float-sm-left">
        <a href="{{ url('tag_index') }}" class="btn btn-link">
            {{ 'action.back_to_list' }}
        </a>
    </div>
    {{ form_end(form) }}
{% endblock %}
