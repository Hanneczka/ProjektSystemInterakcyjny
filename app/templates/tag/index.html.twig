{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_list'|trans }}
{% endblock %}

{% block body %}
    <p><a href="{{ path('element_index') }}">
            {{ 'title.record_list'|trans }}
        </a></p>
    <p><a href="{{ path('category_index') }}">
            {{ 'title.category_list'|trans }}
        </a></p>
    <p><a href="{{ path('tag_index') }}">
            {{ 'title.tag_list'|trans }}
        </a></p>
<h1>{{ 'title.tag_list'|trans }}</h1>
    {% if pagination is defined and pagination.items|length %}
        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>
<table class="table table-stripped" border="1">
    <thead>
    <tr>
        <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans , 'tag.id') }}</th>
        <th>{{ knp_pagination_sortable(pagination,  'label.tags'|trans , 'tag.title') }}</th>
        <th>{{ 'label.actions'|trans }}</th>
    </tr>
    </thead>
    {% for tag in pagination %}
<tr>
    <td>{{ tag.id }}</td>
    <td>{{ tag.title }}</td>
    <td><a href="{{ path('tag_view', {id: tag.id}) }}"class="btn btn-primary">
            {{ 'action.view'|trans }}</a></td>
    <td><a href="{{ path('tag_edit', {id: tag.id}) }}"class="btn btn-primary">
            {{ 'action.edit'|trans }}</a></td>
    <td><a href="{{ path('tag_delete', {id: tag.id}) }}"class="btn btn-primary">
            {{ 'action.delete'|trans }}</a></td>
</tr>
    {% else %}
        <p>{{ 'message.empty_list'|trans }}</p>
    {% endfor %}
</table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {%else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'warning',
            message: 'message.empty_list'|trans
        } %}
    {% endif %}
    <a href="{{ path('tag_create') }}"class="btn btn-primary">{{ 'title.tag_create'|trans }}</a>
    {% endblock %}

