{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.tag_list'|trans }}
{% endblock %}

{% block body %}

<h1>{{ 'title.tag_list'|trans }}</h1>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('tag_create') }}" class="btn btn-primary m-3">{{ 'title.tag_create'|trans }}</a>
    {% endif %}

    {% if pagination is defined and pagination.items|length %}
        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>
<table class="table table-stripped border=1">
    <thead>
    <tr>
        {% if is_granted('ROLE_ADMIN') %}
        <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans , 'tag.id') }}</th>
        {% endif %}
        <th>{{ knp_pagination_sortable(pagination,  'label.tags'|trans , 'tag.title') }}</th>
        {% if is_granted('ROLE_ADMIN') %}
        <th></th>
        <th></th>
        {% endif %}
    </tr>
    </thead>
    {% for tag in pagination %}
    <tr>
        {% if is_granted('ROLE_ADMIN') %}
        <td>{{ tag.id }}</td>
        {% endif %}
        {% if is_granted('TAG_VIEW', tag) %}
        <td><h5><a href="{{ path('tag_view', {slug: tag.slug}) }}" class='title'>
                {{ tag.title }}</a></h5></td>
        {% else %}
            <td><h5 class='title'>
                        {{ tag.title }}</h5></td>
        {% endif %}
        {% if is_granted('TAG_EDIT', tag) %}
        <td><a href="{{ path('tag_edit', {slug: tag.slug}) }}" class="btn btn-primary">
            {{ 'action.edit'|trans }}</a></td>
        {% endif %}
        {% if is_granted('TAG_DELETE', tag) %}
        <td><a href="{{ path('tag_delete', {slug: tag.slug}) }}" class="btn btn-danger">
            {{ 'action.delete'|trans }}</a></td>
        {% endif %}
    </tr>
    {% else %}
        <p>{{ 'message.empty_list'|trans }}</p>
    {% endfor %}
</table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {%else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'warning',
            message: 'message.empty_list'|trans} %}
    {% endif %}

    {% endblock %}

