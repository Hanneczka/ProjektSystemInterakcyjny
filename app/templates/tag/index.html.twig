{% extends 'base.html.twig' %}
{% block body %}
<h1>Lista tagów</h1>
    {% if pagination is defined and pagination.items|length %}
        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>
<table>
    <thead>
    <tr>
        <th>{{ knp_pagination_sortable(pagination, 'Id', 'tag.id') }}</th>
        <th>{{ knp_pagination_sortable(pagination, 'Nazwa', 'tag.title') }}</th>
        <th>Akcje</th>
    </tr>
    </thead>
    {% for tag in pagination %}
<tr>
    <td>{{ tag.id }}</td>
    <td>{{ tag.title }}</td>
    <td><a href="{{ path('tag_view', {id: tag.id}) }}">
            {{ 'tag.view' }}</a></td>
    <td><a href="{{ path('tag_edit', {id: tag.id}) }}">
            {{ 'tag.edit' }}</a></td>
    <td><a href="{{ path('tag_delete', {id: tag.id}) }}">
            {{ 'tag.delete' }}</a></td>
</tr>
    {% else %}
    Brak tagów
    {% endfor %}
</table>
        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    {%else %}
    Brak tagów
    {% endif %}
    <a href="{{ path('tag_create') }}">Dodaj nowy tag</a>
    {% endblock %}

